# ─── LiquidX — Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ─── XRPL Devnet ──────────────────────────────────────────────────────────────
# Generate wallets at: https://faucet.devnet.rippletest.net/accounts

# Platform wallet — server-only, never exposed to browser
XRPL_PLATFORM_SECRET=<platform-seed>
XRPL_PLATFORM_ADDRESS=<platform-r-address>

# WebSocket endpoint
XRPL_WSS=wss://s.devnet.rippletest.net:51233

# Safe to expose to browser
NEXT_PUBLIC_XRPL_NETWORK_ID=1
NEXT_PUBLIC_XRPL_EXPLORER=https://devnet.xrpl.org/transactions

# ─── Optional: override demo wallets ──────────────────────────────────────────
# The app ships with hardcoded devnet demo wallets (zero real-world value).
# Override here to use your own devnet wallets for EscrowCreate / LoanPay signing.
# XRPL_TEST_USER_SECRET=
# XRPL_TEST_USER_ADDRESS=
# XRPL_ASSET_OWNER_SECRET=
# XRPL_ASSET_OWNER_ADDRESS=

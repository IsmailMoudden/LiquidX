# ─── LiquidX — Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ─── XRPL Devnet ──────────────────────────────────────────────────────────────
# Generate a platform wallet at: https://faucet.devnet.rippletest.net/accounts

# Platform wallet — server-only, signs all XRPL transactions
# NEVER prefix with NEXT_PUBLIC_ — must never reach the browser
XRPL_PLATFORM_SECRET=sEd7rhfvaNyp9swzezaAkubkS5V9CWq
XRPL_PLATFORM_ADDRESS=rQDN8QJXcJUVkk3wtRtLwaiqiwxrLPnWik       # devnet r-address

# WebSocket endpoint (devnet)
XRPL_WSS=wss://s.devnet.rippletest.net:51233

# Safe to expose to browser
NEXT_PUBLIC_XRPL_NETWORK_ID=1        # 1 = devnet/testnet, 0 = mainnet
NEXT_PUBLIC_XRPL_EXPLORER=https://devnet.xrpl.org/transactions

